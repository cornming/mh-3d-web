{
  "name": "mh-3d-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node -e \"const {readdirSync,statSync}=require('fs'),{execFileSync}=require('child_process');const walk=(d)=>readdirSync(d).flatMap((f)=>statSync(d+'/'+f).isDirectory()?walk(d+'/'+f):(f.endsWith('.mjs')?[d+'/'+f]:[]));for(const f of [...walk('src'),...walk('tests')])execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
